{
  "description": "Agent Orchestra: dangerous-command guard (PreToolUse) + review/critic gate (Stop)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-dangerous.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/review-gate.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
